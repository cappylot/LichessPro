# Copy to .env and adjust. Every value here has a working default for local use.
# Load it however you like, e.g.:  set -a && . ./.env && set +a && npm start

# Port the app listens on.
PORT=8080

# Absolute base URL you open this app at. Used to build the OAuth redirect_uri
# for your own sign-in, so it MUST match what you type in the browser. The
# default is right for running it on your own machine; your opponent never needs
# to reach this address.
PUBLIC_URL=http://localhost:8080

# Arbitrary identifier shown to players on the Lichess consent screen.
# Lichess has no app registration; any stable string works.
OAUTH_CLIENT_ID=lichesspro

# Where match state (INCLUDING OAuth access tokens) is persisted, so an
# in-progress game survives a restart. Written with 0600 permissions.
DATA_DIR=./.data

# Milliseconds between consecutive add-time calls on ONE token. Lichess caps
# each call at 60 seconds, so a 30-minute bonus is 30 calls; this paces them to
# stay under the API rate limit. Lower = bonus lands faster, higher = safer.
# The two colours are paid with different tokens and are not paced against each
# other, so this is the gap within one player's bonus, not across both.
# Going below ~150 is not advised: a 429 costs a full minute by Lichess's own
# guidance, which is far more than the couple of seconds it would save.
ADD_TIME_INTERVAL_MS=150

# Base URL of the Lichess API. Override only to point at a test double.
LICHESS_HOST=https://lichess.org
